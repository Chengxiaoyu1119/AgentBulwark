# 版本控制与本地工具
.git
.gitignore
.vscode
.trae
.playwright-mcp
**/.playwright-mcp
.tmp-*
gateway-*.png

# 归档与非运行时目录
archive
docs
training
scripts

# 依赖与缓存（镜像内重新安装）
node_modules
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.pyc
.coverage
coverage
htmlcov
test-results
playwright-report
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地运行产物（容器内按需生成）
apps/api/runtime
apps/api/sandbox/runtime
apps/api/sandbox/reports
apps/api/sandbox/workspace
apps/api/sandbox/outbox
apps/api/sandbox/memory
apps/api/sandbox/external_agent_runtime
apps/api/sandbox/release
apps/api/sandbox/submission_packages
apps/api/sandbox/competition-package
apps/api/.coverage
coverage.xml

# 测试与开发工具不进入生产运行镜像
apps/api/tests
apps/api/requirements-dev.txt
apps/console/e2e

# 前端本地产物（镜像内多阶段重新构建）
apps/console/dist
apps/console/coverage

# 密钥与本地环境配置（防止泄漏进镜像）
.env
.env.*
**/.env
**/.env.*

# 文档
*.md
LICENSE
