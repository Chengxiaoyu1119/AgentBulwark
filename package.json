{
  "name": "agent-security-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "npm run console:dev",
    "install:all": "npm --prefix apps/console ci && python -m pip install -r apps/api/requirements-dev.txt",
    "build": "npm run console:build",
    "console:dev": "npm --prefix apps/console run dev",
    "console:build": "npm --prefix apps/console run build",
    "console:preview": "npm --prefix apps/console run preview",
    "console:lint": "npm --prefix apps/console run lint",
    "console:lint:strict": "npm --prefix apps/console run lint:strict",
    "console:format": "npm --prefix apps/console run format",
    "console:format:check": "npm --prefix apps/console run format:check",
    "console:test": "npm --prefix apps/console run test",
    "ui:audit": "npm --prefix apps/console run ui:audit",
    "api": "npm run api:dev",
    "api:dev": "python -X utf8 -m apps.api.dev_server",
    "api:cli": "node scripts/agent-supervisor-cli.mjs",
    "cli": "node scripts/agent-supervisor-cli.mjs",
    "api:lint": "python -m ruff check apps/api",
    "api:typecheck": "mypy --explicit-package-bases apps/api/agent_supervisor apps/api/tests",
    "api:check": "python -X utf8 -m compileall apps/api/agent_supervisor",
    "api:test": "python -X utf8 -m unittest discover -s apps/api/tests -t . -p \"test_*.py\"",
    "api:coverage": "coverage run -m unittest discover -s apps/api/tests -t . -p \"test_*.py\" && coverage report --fail-under=85",
    "audit:security": "node scripts/dependency-security-audit.mjs",
    "audit:raw:console": "npm audit --prefix apps/console --audit-level=low --registry=https://registry.npmjs.org",
  "materials:refresh": "python -X utf8 scripts/refresh_shanghai_technical_report.py",
  "self:review": "node scripts/project-self-review.mjs --output apps/api/sandbox/reports",
  "self:review:test": "node --test scripts/project-self-review-identity.test.mjs",
  "verify": "npm run self:review:test && npm run console:lint:strict && npm run ui:audit && npm run console:test && npm run api:lint && npm run api:typecheck && npm run api:check && npm run api:architecture && npm run api:test && npm run build",
    "api:architecture": "node scripts/backend-governance-check.mjs"
  }
}
