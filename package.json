{
  "name": "agent-security-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "npm run start:local",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/启动智安哨.ps1",
    "dev:console": "npm run console:dev",
    "proof:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/production-proof-smoke.ps1",
    "proof:production:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/production-proof-smoke.ps1 -FullRegression",
    "deploy:config": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployment-acceptance.ps1 -ConfigOnly",
    "deploy:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployment-acceptance.ps1",
    "backup:create": "python -X utf8 -m apps.api.agent_supervisor.commands.runtime_backup create",
    "backup:verify": "python -X utf8 -m apps.api.agent_supervisor.commands.runtime_backup verify",
    "backup:restore": "python -X utf8 -m apps.api.agent_supervisor.commands.runtime_backup restore",
    "install:all": "npm --prefix apps/console ci && python -m pip install -r apps/api/requirements-dev.txt",
    "build": "npm run console:build",
    "console:dev": "npm --prefix apps/console run dev",
    "console:build": "npm --prefix apps/console run build",
    "console:preview": "npm --prefix apps/console run preview",
    "console:lint": "npm --prefix apps/console run lint",
    "console:lint:strict": "npm --prefix apps/console run lint:strict",
    "console:format": "npm --prefix apps/console run format",
    "console:format:check": "npm --prefix apps/console run format:check",
    "console:test": "npm --prefix apps/console run test",
    "console:test:e2e": "npm --prefix apps/console run test:e2e",
    "ui:audit": "npm --prefix apps/console run ui:audit",
    "api": "npm run api:dev",
    "api:dev": "python -X utf8 -m apps.api.dev_server",
    "api:cli": "node scripts/agent-supervisor-cli.mjs",
    "cli": "node scripts/agent-supervisor-cli.mjs",
    "api:lint": "python -m ruff check apps/api",
    "api:typecheck": "mypy --explicit-package-bases apps/api/agent_supervisor apps/api/tests",
    "api:check": "python -X utf8 -m compileall apps/api/agent_supervisor",
    "api:test": "python -X utf8 -m unittest discover -s apps/api/tests -t . -p \"test_*.py\"",
    "api:coverage": "python -m coverage run -m unittest discover -s apps/api/tests -t . -p \"test_*.py\" && python -m coverage report --fail-under=85",
    "api:coverage:production": "python -X utf8 scripts/production-coverage.py",
    "api:perf": "python -X utf8 -m unittest apps.api.tests.test_mcp_gateway.SupervisionLatencyTest.test_interceptor_overhead_p95_under_10ms",
    "audit:security": "node scripts/dependency-security-audit.mjs",
    "audit:raw:console": "npm audit --prefix apps/console --audit-level=low --registry=https://registry.npmjs.org",
    "materials:refresh": "python -X utf8 scripts/refresh_shanghai_technical_report.py",
    "self:review": "node scripts/project-self-review.mjs --output apps/api/sandbox/reports",
    "self:review:test": "node --test scripts/project-self-review-identity.test.mjs",
    "verify": "npm run self:review:test && npm run console:lint:strict && npm run console:format:check && npm run ui:audit && npm run console:test && npm run api:lint && npm run api:typecheck && npm run api:check && npm run api:architecture && npm run api:coverage && npm run api:coverage:production && npm run api:perf && npm run build && npm run console:test:e2e && npm run audit:security",
    "verify:local": "npm run verify",
    "verify:container": "npm run deploy:config && npm run deploy:verify",
    "verify:release": "npm run verify && npm run verify:container",
    "api:architecture": "node scripts/backend-governance-check.mjs"
  }
}
