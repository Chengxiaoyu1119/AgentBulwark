# Optional real model providers. The platform works without keys through the local simulator.
MODEL_REAL_API_ENABLED=false
MODEL_PROVIDER_PRIORITY=openai-compatible,deepseek,zhipu
MODEL_TIMEOUT_SECONDS=12

# Token checks stay enabled by default. The local one-click launcher overrides this only while bound to 127.0.0.1.
AGENT_SUPERVISOR_AUTH_DISABLED=false
AGENT_SUPERVISOR_API_TOKEN=
# Production-style role tokens are mapped by the server. Client role headers are not trusted.
AGENT_SUPERVISOR_API_TOKEN_ADMIN=
AGENT_SUPERVISOR_API_TOKEN_EXECUTOR=
AGENT_SUPERVISOR_AGENT_TOKENS_JSON={}
AGENT_SUPERVISOR_ALLOW_SHARED_EXECUTOR_TOKEN=false
AGENT_SUPERVISOR_API_TOKEN_ANALYST=
AGENT_SUPERVISOR_API_TOKEN_OBSERVER=
AGENT_SUPERVISOR_DEFAULT_ROLE=observer
AGENT_SUPERVISOR_CORS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
# Optional HMAC signing key for tamper-evident audit records. Use a long random value in deployments.
AGENT_SUPERVISOR_AUDIT_HMAC_KEY=
AGENT_SUPERVISOR_AUDIT_HMAC_KEY_ID=local-hmac-v1

# Image used only for caller-authored code.run commands. The executor starts an
# ephemeral container with no network, a read-only root filesystem and strict
# CPU/memory/process limits. Keep this image pre-pulled for offline competitions.
AGENT_SUPERVISOR_COMMAND_CONTAINER_IMAGE=python:3.12-alpine
# Windows fallback when Docker Desktop is offline: WSL2 mount/PID/network namespaces.
AGENT_SUPERVISOR_COMMAND_WSL_DISTRO=Ubuntu

# Generic OpenAI-compatible provider. Can be OpenAI, a domestic compatible gateway, or a local model gateway.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

# DeepSeek OpenAI-compatible chat endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Zhipu / BigModel chat endpoint.
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4.6v-flashx

# Optional independent dual-model providers.
# Optimizer model uses OPTIMIZER_* first, then falls back to the generic provider settings above.
OPTIMIZER_MODEL_PROVIDER_PRIORITY=zhipu,deepseek,openai-compatible
OPTIMIZER_OPENAI_COMPATIBLE_API_KEY=
OPTIMIZER_OPENAI_COMPATIBLE_BASE_URL=
OPTIMIZER_OPENAI_COMPATIBLE_MODEL=
OPTIMIZER_DEEPSEEK_API_KEY=
OPTIMIZER_DEEPSEEK_BASE_URL=
OPTIMIZER_DEEPSEEK_MODEL=
OPTIMIZER_ZHIPU_API_KEY=
OPTIMIZER_ZHIPU_API_URL=
OPTIMIZER_ZHIPU_MODEL=

# Target model uses TARGET_* first, then falls back to the generic provider settings above.
TARGET_MODEL_PROVIDER_PRIORITY=deepseek,zhipu,openai-compatible
TARGET_OPENAI_COMPATIBLE_API_KEY=
TARGET_OPENAI_COMPATIBLE_BASE_URL=
TARGET_OPENAI_COMPATIBLE_MODEL=
TARGET_DEEPSEEK_API_KEY=
TARGET_DEEPSEEK_BASE_URL=
TARGET_DEEPSEEK_MODEL=
TARGET_ZHIPU_API_KEY=
TARGET_ZHIPU_API_URL=
TARGET_ZHIPU_MODEL=

# Optional local OpenAI-compatible guarded proxy:
# POST http://127.0.0.1:8012/v1/chat/completions
AGENT_SUPERVISOR_PROXY_ENABLED=true
AGENT_SUPERVISOR_PROXY_ALLOW_LOCAL_UNAUTHENTICATED=true
AGENT_SUPERVISOR_PROXY_ALLOW_UNAUTHENTICATED_PUBLIC=false
AGENT_SUPERVISOR_TRUST_PROXY_HEADERS=false
AGENT_SUPERVISOR_PROXY_RATE_LIMIT_PER_MINUTE=30
AGENT_SUPERVISOR_PROXY_OPTIMIZER_ENABLED=true
AGENT_SUPERVISOR_PROXY_FORCE_REAL_OPTIMIZER=false
AGENT_SUPERVISOR_PROXY_FORCE_REAL_TARGET=false
AGENT_SUPERVISOR_PROXY_OPTIMIZER_MODEL=
AGENT_SUPERVISOR_PROXY_TARGET_MODEL=
