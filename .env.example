# Optional real model providers. The runtime labs can use the local simulator;
# the production-transparent OpenAI proxy requires a configured provider.
MODEL_REAL_API_ENABLED=false
MODEL_PROVIDER_PRIORITY=openai-compatible,deepseek,zhipu
MODEL_TIMEOUT_SECONDS=12
MODEL_MAX_PROVIDER_RESPONSE_BYTES=8388608
# Provider address resolution for the pinned outbound connection. `system` is
# the default. Use `doh` only when the host resolver is a synthetic/private
# mapping and the configured DoH endpoint is reachable from the deployment.
AGENT_SUPERVISOR_PROVIDER_DNS_MODE=system
AGENT_SUPERVISOR_PROVIDER_DOH_URL=https://cloudflare-dns.com/dns-query
AGENT_SUPERVISOR_PROVIDER_DOH_TIMEOUT_SECONDS=5

# Token checks stay enabled by default. The local one-click launcher overrides this only while bound to 127.0.0.1.
AGENT_SUPERVISOR_AUTH_DISABLED=false
# Public/managed launches set this to production automatically; local loopback
# launches use local compatibility defaults unless explicitly overridden.
# AGENT_SUPERVISOR_SECURITY_PROFILE=production
AGENT_SUPERVISOR_API_TOKEN=
# Production-style role tokens are mapped by the server. Client role headers are not trusted.
AGENT_SUPERVISOR_API_TOKEN_ADMIN=
AGENT_SUPERVISOR_API_TOKEN_EXECUTOR=
AGENT_SUPERVISOR_AGENT_TOKENS_JSON={}
## 仅 local 安全档可开启；production 会在启动时拒绝共享 executor Token 兼容路径。
AGENT_SUPERVISOR_ALLOW_SHARED_EXECUTOR_TOKEN=false
AGENT_SUPERVISOR_API_TOKEN_ANALYST=
AGENT_SUPERVISOR_API_TOKEN_OBSERVER=
AGENT_SUPERVISOR_DEFAULT_ROLE=observer
# observer 只能读取状态和 /v1/models；真实 LLM 代理的 executor 默认必须
# 使用绑定到 agent_id 的独立 Agent Token。共享 executor Token 仅用于 local
# 兼容夹具，production 安全档会拒绝该路径。
AGENT_SUPERVISOR_CORS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
# Optional HMAC signing key for tamper-evident audit records. Use a long random value in deployments.
AGENT_SUPERVISOR_AUDIT_HMAC_KEY=
AGENT_SUPERVISOR_AUDIT_HMAC_KEY_ID=local-hmac-v1

# Image used only for caller-authored code.run commands. The executor starts an
# ephemeral container with no network, a read-only root filesystem and strict
# CPU/memory/process limits. Keep this image pre-pulled for offline competitions.
AGENT_SUPERVISOR_COMMAND_CONTAINER_IMAGE=python:3.12-alpine
# WSL fallback is disabled by default: its mount namespace does not guarantee
# that Windows-mounted drives are hidden from an untrusted command. Enable only
# for disposable local fixtures, never in a production profile.
AGENT_SUPERVISOR_COMMAND_ALLOW_WSL_FALLBACK=false
AGENT_SUPERVISOR_COMMAND_WSL_DISTRO=Ubuntu

# MCP stdio upstreams receive only a small runtime environment by default.
# Add explicit, non-secret variables here when a server needs them.
MCP_GATEWAY_UPSTREAM_ENV_ALLOWLIST=
# 无 id 的 tools/call 没有响应/回执通道，生产默认拒绝；仅兼容旧客户端时显式开启。
MCP_GATEWAY_ALLOW_SIDE_EFFECT_NOTIFICATIONS=false
MCP_GATEWAY_TIMEOUT_SECONDS=10
# Every MCP frame is bounded before JSON parsing; oversized output terminates the upstream process.
MCP_GATEWAY_MAX_MESSAGE_BYTES=1048576
MCP_GATEWAY_MAX_PENDING_RESPONSES=256
# On POSIX hosts, apply CPU/memory/PID/open-file/file-size limits in the child process.
MCP_GATEWAY_RESOURCE_LIMITS_ENABLED=true
# MCP stdio 子进程自有网络连接，网关默认拒绝无法绑定解析地址的绝对 HTTP 目标。
# 仅旧客户端兼容时显式设置 allow-unpinned，并把它视为降级证据。
MCP_GATEWAY_NETWORK_MODE=reject-unpinned
# Each authenticated Agent session gets an independent MCP stdio child and
# private tool/resource catalog. Set false only for legacy single-session
# compatibility; the production default is isolated.
MCP_GATEWAY_SESSION_ISOLATION=true
MCP_GATEWAY_MAX_SESSIONS=128
MCP_GATEWAY_MAX_CPU_SECONDS=30
MCP_GATEWAY_MAX_MEMORY_BYTES=536870912
MCP_GATEWAY_MAX_PIDS=128
MCP_GATEWAY_MAX_OPEN_FILES=256
MCP_GATEWAY_MAX_FILE_BYTES=16777216

# Generic OpenAI-compatible provider. Can be OpenAI, a domestic compatible gateway, or a local model gateway.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

# DeepSeek OpenAI-compatible chat endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Zhipu / BigModel chat endpoint.
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4.6v-flashx

# Optional independent dual-model providers.
# Optimizer model uses OPTIMIZER_* first, then falls back to the generic provider settings above.
OPTIMIZER_MODEL_PROVIDER_PRIORITY=zhipu,deepseek,openai-compatible
OPTIMIZER_OPENAI_COMPATIBLE_API_KEY=
OPTIMIZER_OPENAI_COMPATIBLE_BASE_URL=
OPTIMIZER_OPENAI_COMPATIBLE_MODEL=
OPTIMIZER_DEEPSEEK_API_KEY=
OPTIMIZER_DEEPSEEK_BASE_URL=
OPTIMIZER_DEEPSEEK_MODEL=
OPTIMIZER_ZHIPU_API_KEY=
OPTIMIZER_ZHIPU_API_URL=
OPTIMIZER_ZHIPU_MODEL=

# Target model uses TARGET_* first, then falls back to the generic provider settings above.
TARGET_MODEL_PROVIDER_PRIORITY=deepseek,zhipu,openai-compatible
TARGET_OPENAI_COMPATIBLE_API_KEY=
TARGET_OPENAI_COMPATIBLE_BASE_URL=
TARGET_OPENAI_COMPATIBLE_MODEL=
TARGET_DEEPSEEK_API_KEY=
TARGET_DEEPSEEK_BASE_URL=
TARGET_DEEPSEEK_MODEL=
TARGET_ZHIPU_API_KEY=
TARGET_ZHIPU_API_URL=
TARGET_ZHIPU_MODEL=
# Strict real-model evidence must use one fixed Provider and never fall back.
# Set this when more than one target Provider has a key: openai-compatible, deepseek, or zhipu.
TARGET_REAL_MODEL_PROVIDER=
# Global selector used when the profile-specific selector above is empty.
REAL_MODEL_EVALUATION_PROVIDER=
# Optional Agent identity used by real-model-eval. When empty, the evaluator
# selects a currently registered identity that can perform the benign cases;
# an unregistered explicit value is reported as an evidence gap.
AGENT_SUPERVISOR_REAL_MODEL_EVALUATION_AGENT_ID=

# Optional local OpenAI-compatible guarded proxy:
# POST http://127.0.0.1:8012/v1/chat/completions
AGENT_SUPERVISOR_PROXY_ENABLED=true
AGENT_SUPERVISOR_PROXY_ALLOW_LOCAL_UNAUTHENTICATED=true
AGENT_SUPERVISOR_PROXY_ALLOW_UNAUTHENTICATED_PUBLIC=false
AGENT_SUPERVISOR_TRUST_PROXY_HEADERS=false
AGENT_SUPERVISOR_PROXY_RATE_LIMIT_PER_MINUTE=30
AGENT_SUPERVISOR_PROXY_RATE_LIMIT_MAX_KEYS=10000
# Rate-limit buckets are stored in the shared runtime SQLite database so all
# API workers enforce one per-client window.
# Per-Agent resource lease. A managed request reserves all possible Provider
# rounds before the first call; 0 disables an individual quota deliberately.
AGENT_SUPERVISOR_PROXY_RESOURCE_GOVERNANCE_ENABLED=true
AGENT_SUPERVISOR_PROXY_MAX_CONCURRENCY_PER_AGENT=8
AGENT_SUPERVISOR_PROXY_TOKEN_BUDGET_PER_MINUTE=1000000
AGENT_SUPERVISOR_PROXY_COST_BUDGET_PER_MINUTE_USD=0
AGENT_SUPERVISOR_PROXY_DEFAULT_OUTPUT_TOKENS=1024
AGENT_SUPERVISOR_PROXY_MANAGED_CONTEXT_TOKENS=16384
AGENT_SUPERVISOR_PROXY_INPUT_COST_PER_1K_USD=0
AGENT_SUPERVISOR_PROXY_OUTPUT_COST_PER_1K_USD=0
AGENT_SUPERVISOR_PROXY_RESOURCE_MAX_KEYS=10000
# Shared SQLite lease lifetime. A crashed worker's reservation is reclaimed
# after this interval; set above the maximum expected Provider request time.
AGENT_SUPERVISOR_PROXY_RESOURCE_LEASE_TTL_SECONDS=300
# Keep false unless the privacy trade-off of sending one prompt to another
# provider after a transport failure has been explicitly accepted.
AGENT_SUPERVISOR_PROXY_ALLOW_PROVIDER_FAILOVER=false
AGENT_SUPERVISOR_PROXY_ALLOW_MODEL_OVERRIDE=false
# The proxy preserves the caller's messages/tools by default. Research prompt
# rewriting is disabled unless explicitly enabled for analyst/admin work and is
# rejected unconditionally by the production security profile.
AGENT_SUPERVISOR_PROXY_MODE=transparent
AGENT_SUPERVISOR_PROXY_ALLOW_RESEARCH_MODE=false
# In network proxy mode, a role=tool message must carry a verified execution
# receipt bound to the preceding assistant tool call. Set false only for legacy
# clients that accept caller-owned, unverified tool results.
AGENT_SUPERVISOR_PROXY_REQUIRE_TOOL_RECEIPTS=true
# Production profile always requires a receipt produced by the supervisor-owned
# executor. Local SDK integration can explicitly enable the same invariant;
# false in a production profile does not weaken the effective policy.
AGENT_SUPERVISOR_PROXY_REQUIRE_SERVER_OBSERVED_RECEIPTS=false
# Reasoning/analysis channels are inspected but hidden from downstream Agents by default.
AGENT_SUPERVISOR_PROXY_EXPOSE_REASONING=false
# Maximum number of server-owned tool execution rounds for
# agent_supervisor.mode=managed. The final Provider response is still checked;
# a new tool call after this limit is blocked instead of returned to the Agent.
AGENT_SUPERVISOR_PROXY_MAX_TOOL_ROUNDS=3
AGENT_SUPERVISOR_PROXY_OPTIMIZER_ENABLED=true
AGENT_SUPERVISOR_PROXY_FORCE_REAL_OPTIMIZER=false
AGENT_SUPERVISOR_PROXY_FORCE_REAL_TARGET=false
AGENT_SUPERVISOR_PROXY_OPTIMIZER_MODEL=
AGENT_SUPERVISOR_PROXY_TARGET_MODEL=
