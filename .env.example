# AgentBulwark / 智垒单机运行配置。复制为 .env 后按需填写；密钥只由后端读取。

# 本地默认免登录。局域网或生产部署必须关闭并配置 Bearer Token。
AGENT_SUPERVISOR_API_HOST=127.0.0.1
AGENT_SUPERVISOR_API_PORT=8012
AGENT_SUPERVISOR_AUTH_DISABLED=true
AGENT_SUPERVISOR_API_TOKEN=
AGENT_SUPERVISOR_DEFAULT_ROLE=admin
AGENT_SUPERVISOR_LOCAL_OPERATOR_ROLE=admin
AGENT_SUPERVISOR_AGENT_TOKENS_JSON={}
AGENT_SUPERVISOR_API_TOKEN_ADMIN=
AGENT_SUPERVISOR_API_TOKEN_ANALYST=
AGENT_SUPERVISOR_API_TOKEN_EXECUTOR=
AGENT_SUPERVISOR_API_TOKEN_OBSERVER=
AGENT_SUPERVISOR_SECURITY_PROFILE=local
AGENT_SUPERVISOR_CORS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

# 运行数据只写入仓库内 apps/api/runtime；需要隔离数据时指定仓库内子目录。
# AGENT_SUPERVISOR_RUNTIME_DIR=apps/api/runtime/operational

# 审计 Hash 可在本地无密钥运行；要验证完整 Provider + MCP 闭环，必须配置高熵 HMAC 密钥。
AGENT_SUPERVISOR_AUDIT_HMAC_KEY=
AGENT_SUPERVISOR_AUDIT_HMAC_KEY_ID=local-hmac-v1

# OpenAI-compatible Provider。地址和模型固定后才允许真实出口连接。
MODEL_REAL_API_ENABLED=false
MODEL_PROVIDER_PRIORITY=openai-compatible,deepseek,zhipu
MODEL_TIMEOUT_SECONDS=12
MODEL_PROVIDER_PROBE_TIMEOUT_SECONDS=8
MODEL_MAX_PROVIDER_RESPONSE_BYTES=8388608
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ZHIPU_API_KEY=
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4.6v-flashx
AGENT_SUPERVISOR_PROVIDER_DNS_MODE=system
AGENT_SUPERVISOR_PROVIDER_DOH_URL=https://cloudflare-dns.com/dns-query
AGENT_SUPERVISOR_PROVIDER_DOH_TIMEOUT_SECONDS=5

# OpenAI 网关策略。透明模式返回已检查的 tool call；托管模式由服务端执行受限本地工具。
AGENT_SUPERVISOR_PROXY_ENABLED=true
AGENT_SUPERVISOR_PROXY_MODE=transparent
AGENT_SUPERVISOR_PROXY_REQUIRE_TOOL_RECEIPTS=true
AGENT_SUPERVISOR_PROXY_REQUIRE_SERVER_OBSERVED_RECEIPTS=true
AGENT_SUPERVISOR_PROXY_ALLOW_LOCAL_UNAUTHENTICATED=true
AGENT_SUPERVISOR_PROXY_ALLOW_UNAUTHENTICATED_PUBLIC=false
AGENT_SUPERVISOR_PROXY_ALLOW_PROVIDER_FAILOVER=false
AGENT_SUPERVISOR_PROXY_ALLOW_MODEL_OVERRIDE=false
AGENT_SUPERVISOR_PROXY_MAX_TOOL_ROUNDS=3
AGENT_SUPERVISOR_PROXY_STREAM_SAFETY_WINDOW_CHARS=256

# MCP Gateway。未配置上游时控制台仍可启动，但不会显示可用工具。
MCP_GATEWAY_ENABLED=true
MCP_GATEWAY_GUARD_ENABLED=true
MCP_GATEWAY_UPSTREAM_COMMAND=
MCP_GATEWAY_UPSTREAM_CWD=
MCP_GATEWAY_UPSTREAM_ENV_ALLOWLIST=
MCP_GATEWAY_ROUTES_JSON={}
MCP_GATEWAY_SERVER_NAME=智垒 MCP Gateway
MCP_GATEWAY_TIMEOUT_SECONDS=10
MCP_GATEWAY_MAX_MESSAGE_BYTES=1048576
MCP_GATEWAY_MAX_PENDING_RESPONSES=256
MCP_GATEWAY_NETWORK_MODE=reject-unpinned
MCP_GATEWAY_SESSION_ISOLATION=true
MCP_GATEWAY_MAX_SESSIONS=128
MCP_GATEWAY_MAX_SUBSCRIPTIONS=128
MCP_GATEWAY_ALLOW_SIDE_EFFECT_NOTIFICATIONS=false
MCP_GATEWAY_REQUEST_STATE_SECRET=
MCP_GATEWAY_MRTR_TIMEOUT_SECONDS=300
MCP_GATEWAY_RESOURCE_LIMITS_ENABLED=true
MCP_GATEWAY_MAX_CPU_SECONDS=30
MCP_GATEWAY_MAX_MEMORY_BYTES=536870912
MCP_GATEWAY_MAX_PIDS=128
MCP_GATEWAY_MAX_OPEN_FILES=256
MCP_GATEWAY_MAX_FILE_BYTES=16777216
