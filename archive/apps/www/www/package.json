{
  "name": "agent-security-supervisor-www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node ../../scripts/start-www-dev.mjs",
    "dev:raw": "vite --host 127.0.0.1 --port 4321 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4321 --strictPort",
    "ui:audit": "node ../../scripts/www-governance-check.mjs",
    "verify": "npm run ui:audit && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
